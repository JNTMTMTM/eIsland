{
  "name": "eisland-macos-media-helper",
  "version": "26.1.2",
  "description": "macOS Now Playing metadata, timeline and controls through Swift and Node-API.",
  "author": "JNTMTMTM",
  "license": "GPL-3.0",
  "main": "index.js",
  "types": "index.d.ts",
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64",
    "x64"
  ],
  "engines": {
