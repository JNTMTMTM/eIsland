{
  "name": "@eisland/windows-startup-helper",
  "version": "26.0.1",
  "description": "Windows startup items, scheduled tasks and services query EXE helper.",
  "author": "JNTMTMTM",
  "license": "GPL-3.0",
  "main": "index.js",
  "types": "index.d.ts",
  "os": [
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64",
    "ia32"
  ],
  "scripts": {
    "postinstall": "dotnet build src/eIslandStartupReader.csproj -c Release",
    "build": "dotnet build src/eIslandStartupReader.csproj -c Release",
    "clean": "dotnet clean src/eIslandStartupReader.csproj",
    "rebuild": "npm run clean && npm run build",
    "test": "vitest run --config vitest.config.mts",
    "smoke": "node test/startup.smoke.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "vitest": "~5.1.0"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "src"
  ]
}
