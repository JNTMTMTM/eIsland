{
  "name": "@eisland/windows-volume-helper",
  "version": "26.0.5",
  "description": "Windows default playback device volume query, control, and monitoring via Core Audio COM.",
  "author": "JNTMTMTM",
  "license": "GPL-3.0",
  "main": "index.js",
  "types": "index.d.ts",
  "os": [
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64",
    "ia32"
  ],
  "scripts": {
    "postinstall": "dotnet build src/eIslandVolumeHelper.csproj -c Release",
    "build": "dotnet build src/eIslandVolumeHelper.csproj -c Release",
    "clean": "dotnet clean src/eIslandVolumeHelper.csproj",
    "rebuild": "npm run clean && npm run build",
    "test": "vitest run --config vitest.config.mts",
    "test:query": "vitest run --config vitest.config.mts test/volume.test.ts",
    "test:monitor": "vitest run --config vitest.config.mts test/volume.monitor.test.ts",
    "smoke": "node --experimental-strip-types test/volume.smoke.ts",
    "smoke:monitor": "node --experimental-strip-types test/volume.monitor.smoke.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "vitest": "~5.0.5"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "src",
    "async-control.js"
  ]
}
