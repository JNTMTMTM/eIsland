{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "plugins/**/test/ffiLoader.test.ts",
    "plugins/test/ffiLoaderHarness.ts",
    "scripts/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "moduleResolution": "bundler",
    "types": ["electron-vite/node"]
  }
}
