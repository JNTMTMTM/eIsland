{
  "name": "eisland",
  "version": "27.0.2",
  "description": "A sleek, Apple Dynamic Island inspired floating widget for Windows, built with Tauri.",
  "author": "JNTMTMTM",
  "license": "GPL-3.0",
  "engines": {
    "node": "24.22.1"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:local": "npm --prefix temp/app run dev:local",
    "build": "tauri build --no-bundle",
    "preview": "tauri dev --no-watch",
    "test": "run-s test:unit test:api test:rust",
    "test:node": "run-s test:shared test:cli test:plugins:unit test:api test:rust",
    "test:main": "npm run test:rust",
    "test:renderer": "vitest run --project renderer",
    "test:preload": "npm run test:api",
    "test:shared": "vitest run --project shared",
    "test:plugins": "vitest run --project plugins --project plugins-integration",
    "test:plugins:unit": "vitest run --project plugins",
    "test:plugins:integration": "vitest run --project plugins-integration",
    "test:plugins:build": "node scripts/test/build-windows-plugins.mjs",
    "test:discovery": "node --test scripts/test/vitest-discovery.test.mjs",
    "test:coverage": "vitest run --coverage --project shared --project renderer --project cli --project plugins",
    "test:cli": "vitest run --project cli",
    "postinstall": "npm ci --prefix cli --ignore-scripts",
    "package": "node scripts/native/package-release.mjs",
    "changelog:generate": "node --experimental-strip-types scripts/generate-changelog.ts -o docs/CHANGE_LOG.md",
    "release:notes": "node --experimental-strip-types scripts/generate-incremental-release-notes.ts -o RELEASE_NOTES_SINCE_LAST_TAG.md",
    "release:upload": "npm run release",
    "release:upload-only": "node scripts/native/upload-release.mjs",
    "release:upload-minio": "node scripts/native/upload-release.mjs --minio-only",
    "comment:check": "npm run lint:comments",
    "i18n:check": "node --experimental-strip-types scripts/check-i18n-completeness.ts",
    "esa:purge": "node --experimental-strip-types scripts/esa/purge-esa-cache.ts",
    "esa:purge-hostname": "node --experimental-strip-types scripts/esa/purge-esa-hostname.ts",
    "esa:purge-all": "node --experimental-strip-types scripts/esa/purge-esa-hostname.ts --purge-all",
    "plugin:build:bluetooth": "cd plugins/windows/eisland-windows-bluetooth-helper && npm run build:all",
    "plugin:build:brightness": "cd plugins/windows/eisland-windows-brightness-helper && npm run build",
    "plugin:build:volume": "cd plugins/windows/eisland-windows-volume-helper && npm run build",
    "plugin:build:volume-analyzer": "cd plugins/windows/eisland-windows-volume-analyzer && npm run build",
    "plugin:build:power": "cd plugins/windows/eisland-windows-power-helper && npm run build:all",
    "plugin:build:processes": "cd plugins/windows/eisland-windows-processes-attacker && npm run build",
    "plugin:build:smtc": "cd plugins/windows/eisland-windows-smtc-helper && npm run build:all",
    "plugin:build:toast": "cd plugins/windows/eisland-windows-toast-listener && npm run build",
    "plugin:build:wifi": "cd plugins/windows/eisland-windows-wifi-helper && npm run build:all",
    "plugin:build:fullscreen": "cd plugins/windows/eisland-windows-fullscreen-detector && npm run build",
    "plugin:build:perfmon": "cd plugins/windows/eisland-windows-performance-monitor && npm run build",
    "plugin:build:icon-helper": "cd plugins/windows/eisland-windows-application-icon-helper && npm run build",
    "plugin:build:screenshot-helper": "cd plugins/windows/eisland-windows-screenshot-helper && npm run build",
    "plugin:clean:bluetooth": "cd plugins/windows/eisland-windows-bluetooth-helper && npm run clean",
    "plugin:clean:brightness": "cd plugins/windows/eisland-windows-brightness-helper && npm run clean",
    "plugin:clean:volume": "cd plugins/windows/eisland-windows-volume-helper && npm run clean",
    "plugin:clean:volume-analyzer": "cd plugins/windows/eisland-windows-volume-analyzer && npm run clean",
    "plugin:clean:power": "cd plugins/windows/eisland-windows-power-helper && npm run clean",
    "plugin:clean:processes": "cd plugins/windows/eisland-windows-processes-attacker && npm run clean",
    "plugin:clean:smtc": "cd plugins/windows/eisland-windows-smtc-helper && npm run clean",
    "plugin:clean:toast": "cd plugins/windows/eisland-windows-toast-listener && npm run clean",
    "plugin:clean:wifi": "cd plugins/windows/eisland-windows-wifi-helper && npm run clean",
    "plugin:clean:fullscreen": "cd plugins/windows/eisland-windows-fullscreen-detector && npm run clean",
    "plugin:clean:perfmon": "cd plugins/windows/eisland-windows-performance-monitor && npm run clean",
    "plugin:clean:icon-helper": "cd plugins/windows/eisland-windows-application-icon-helper && npm run clean",
    "plugin:clean:screenshot-helper": "cd plugins/windows/eisland-windows-screenshot-helper && npm run clean",
    "plugins:build": "node scripts/native/build-native.mjs",
    "plugins:clean": "run-p plugin:clean:bluetooth plugin:clean:brightness plugin:clean:volume plugin:clean:volume-analyzer plugin:clean:power plugin:clean:processes plugin:clean:smtc plugin:clean:toast plugin:clean:wifi plugin:clean:fullscreen plugin:clean:perfmon plugin:clean:icon-helper plugin:clean:screenshot-helper",
    "lint": "node scripts/lint/eslint.mjs . --max-warnings=0",
    "lint:eslint": "node scripts/lint/eslint.mjs . --max-warnings=0",
    "lint:report": "node scripts/lint/eslint.mjs . --max-warnings=0 --format html --output-file reports/eslint.html",
    "lint:report:json": "node scripts/lint/eslint.mjs . --max-warnings=0 --format json --output-file reports/eslint.json",
    "lint:fix": "node scripts/lint/eslint.mjs . --fix --max-warnings=0",
    "lint:css": "stylelint \"{src,web}/**/*.{css,scss}\" \"web/**/.vuepress/**/*.{css,scss}\" --max-warnings=0",
    "lint:css:fix": "npm run lint:css -- --fix",
    "lint:html": "html-validate \"{src,web}/**/*.html\" --max-warnings=0",
    "lint:comments": "node scripts/lint/eslint.mjs . --config scripts/lint/comments.config.mjs --max-warnings=0",
    "lint:all": "run-p --continue-on-error lint:eslint lint:css lint:html i18n:check",
    "lint:config:test": "node --test scripts/lint/config.test.mjs scripts/lint/pr-code-quality-review.test.mjs scripts/lint/pr-report-comments.test.mjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "run-p --continue-on-error typecheck:node typecheck:web",
    "check": "run-p --continue-on-error lint:all typecheck test",
    "build:e2e": "tauri build --debug --no-bundle",
    "build:e2e:windows:native": "npm run plugins:build",
    "build:e2e:windows": "npm run plugins:build && npm run build:e2e",
    "test:e2e": "node scripts/native/smoke.mjs --packaged --music --agent && npm run test:services",
    "test:e2e:windows": "npm run test:e2e",
    "test:e2e:run": "npm run test:e2e",
    "typecheck:e2e": "node --check scripts/native/smoke.mjs && node --check scripts/native/native-services.test.mjs && node --check scripts/native/toolbox-services.test.mjs && node --check scripts/native/updater-services.test.mjs",
    "dev:web": "vite --config vite.config.ts",
    "build:web": "vite build --config vite.config.ts",
    "tauri": "tauri",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "test:rust": "cargo test --locked --all-targets --manifest-path src-tauri/Cargo.toml",
    "test:unit": "vitest run --project shared --project renderer --project cli --project plugins",
    "release": "npm run package && npm run release:upload-only",
    "test:release": "node --test scripts/native/release.test.mjs scripts/native/prepare-ffprobe.test.mjs scripts/native/test-signing.test.mjs",
    "native": "npm run plugins:build",
    "test:api": "node --test scripts/native/cdp.test.mjs scripts/native/api.test.mjs scripts/test/native-runtime.test.mjs scripts/native/release.test.mjs scripts/native/architecture.test.mjs scripts/native/toolbox-coverage.test.mjs scripts/native/prepare-ffprobe.test.mjs scripts/native/native-coverage.test.mjs scripts/native/test-signing.test.mjs",
    "test:services": "node --test scripts/native/native-services.test.mjs && node --test scripts/native/toolbox-services.test.mjs && node --test scripts/native/updater-services.test.mjs",
    "test:toolbox": "vitest run --config vitest.toolbox.config.mts",
    "test:toolbox:coverage": "node scripts/native/toolbox-coverage.mjs",
    "test:toolbox:rust:prepare": "node scripts/native/toolbox-rust-coverage.mjs --prepare",
    "test:toolbox:rust:env": "node scripts/native/toolbox-rust-coverage.mjs --env-pwsh",
    "test:toolbox:coverage:rust": "node scripts/native/toolbox-rust-coverage.mjs --report"
  },
  "dependencies": {
    "@eisland/windows-application-icon-helper": "file:plugins/windows/eisland-windows-application-icon-helper",
    "@eisland/windows-bluetooth-helper": "file:plugins/windows/eisland-windows-bluetooth-helper",
    "@eisland/windows-brightness-helper": "file:plugins/windows/eisland-windows-brightness-helper",
    "@eisland/windows-fullscreen-detector": "file:plugins/windows/eisland-windows-fullscreen-detector",
    "@eisland/windows-performance-monitor": "file:plugins/windows/eisland-windows-performance-monitor",
    "@eisland/windows-power-helper": "file:plugins/windows/eisland-windows-power-helper",
    "@eisland/windows-processes-attacker": "file:plugins/windows/eisland-windows-processes-attacker",
    "@eisland/windows-screenshot-helper": "file:plugins/windows/eisland-windows-screenshot-helper",
    "@eisland/windows-smtc-helper": "file:plugins/windows/eisland-windows-smtc-helper",
    "@eisland/windows-toast-listener": "file:plugins/windows/eisland-windows-toast-listener",
    "@eisland/windows-volume-helper": "file:plugins/windows/eisland-windows-volume-helper",
    "@eisland/windows-wifi-helper": "file:plugins/windows/eisland-windows-wifi-helper",
    "@gsap/react": "^2.1.2",
    "@multisystemsuite/timezone-engine-core": "^5.0.0",
    "@tailwindcss/vite": "^4.3.4",
    "colorthief": "^3.5.0",
    "date-fns": "4.4.0",
    "debug": "^4.4.3",
    "dompurify": "^3.4.17",
    "fetch-installed-software": "^0.0.7",
    "flag-icons": "^7.6.0",
    "function-plot": "^1.26.0",
    "get-windows": "^9.3.0",
    "gsap": "^3.15.1",
    "highcharts": "^13.1.1",
    "highcharts-react-official": "^3.2.3",
    "i18next": "^26.7.2",
    "imapflow": "^2.10.2",
    "katex": "^0.19.1",
    "lunar-javascript": "^1.7.7",
    "lyric-resolver": "^0.1.6",
    "mailparser": "^3.14.2",
    "open": "^11.0.4",
    "openmeteo": "^1.2.3",
    "qrcode.react": "^4.2.0",
    "react-datepicker": "^9.1.0",
    "react-i18next": "^17.1.13",
    "react-katex": "^3.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "stock-api": "^2.7.5",
    "systeminformation": "^5.33.19",
    "tesseract.js": "^7.0.0",
    "uapi-sdk-typescript": "^0.1.18",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "js-yaml": "^4.1.0",
    "@alicloud/credentials": "^2.4.7",
    "@alicloud/esa20240910": "^3.15.0",
    "@alicloud/openapi-client": "^0.4.15",
    "@alicloud/tea-util": "^1.4.11",
    "@playwright/test": "^1.65.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-katex": "^3.0.4",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "autoprefixer": "^10.6.2",
    "esbuild": "0.28.2",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^1.69.0",
    "node-abi": "^4.40.0",
    "npm-run-all2": "^9.0.4",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.0.5"
  },
  "workspaces": [
    "scripts/lint"
  ],
  "overrides": {
    "tar": "^7.5.22",
    "ts-api-utils": {
      "typescript": "~6.0.3"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "ffmpeg-static": true,
    "get-windows": true,
    "koffi@2.16.2": true,
    "tesseract.js@7.0.0": true,
    "unrs-resolver@1.12.2": true,
    "@alicloud/openapi-core@1.0.8": true,
    "file:../../plugins/windows/eisland-windows-brightness-helper": true,
    "file:../../plugins/windows/eisland-windows-smtc-helper": true,
    "file:../../plugins/windows/eisland-windows-application-icon-helper": true,
    "file:../../plugins/windows/eisland-windows-bluetooth-helper": true,
    "file:../../plugins/windows/eisland-windows-toast-listener": true,
    "file:../../plugins/windows/eisland-windows-fullscreen-detector": true,
    "file:../../plugins/windows/eisland-windows-screenshot-helper": true,
    "file:../../plugins/windows/eisland-windows-performance-monitor": true,
    "file:../../plugins/windows/eisland-windows-volume-helper": true,
    "file:../../plugins/windows/eisland-windows-processes-attacker": true,
    "file:../../plugins/windows/eisland-windows-wifi-helper": true,
    "file:../../plugins/windows/eisland-windows-power-helper": true,
    "koffi@3.3.4": true
  }
}
